# Database (Postgres — Neon, Supabase, Railway, or local)
DATABASE_URL="postgresql://user:password@localhost:5432/emek_elibrary?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# AI assistant (Claude API)
ANTHROPIC_API_KEY="sk-ant-..."
# Optional — override the model. See https://docs.claude.com/en/docs/about-claude/models
# ANTHROPIC_MODEL="claude-sonnet-4-6"

# File storage for book cover images / page images (S3-compatible, e.g. Cloudflare R2 or Supabase Storage)
STORAGE_BUCKET_URL="https://your-bucket.example.com"
